# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca faça commit do .env.

# Servidor
PORT=3001
# URL pública da API, usada para montar a URL das imagens (sem barra no final)
APP_URL=http://localhost:3001
# Origens do front liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173,https://seudominio.com

# JWT
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=dev-burguer-db

# MongoDB
MONGO_URL=mongodb://localhost:27017/devburguer

# Stripe
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
